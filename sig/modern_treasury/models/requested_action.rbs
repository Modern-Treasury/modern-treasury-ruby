module ModernTreasury
  module Models
    type requested_action =
      {
        id: String,
        category: ModernTreasury::Models::RequestedAction::category,
        created_at: Time,
        field: ModernTreasury::Models::RequestedAction::field?,
        instructions: String?,
        live_mode: bool,
        object: String,
        reasons: ::Array[String],
        updated_at: Time
      }

    class RequestedAction < ModernTreasury::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor category: ModernTreasury::Models::RequestedAction::category

      attr_accessor created_at: Time

      attr_accessor field: ModernTreasury::Models::RequestedAction::field?

      attr_accessor instructions: String?

      attr_accessor live_mode: bool

      attr_accessor object: String

      attr_accessor reasons: ::Array[String]

      attr_accessor updated_at: Time

      def initialize: (
        id: String,
        category: ModernTreasury::Models::RequestedAction::category,
        created_at: Time,
        field: ModernTreasury::Models::RequestedAction::field?,
        instructions: String?,
        live_mode: bool,
        object: String,
        reasons: ::Array[String],
        updated_at: Time
      ) -> void

      def to_hash: -> {
        id: String,
        category: ModernTreasury::Models::RequestedAction::category,
        created_at: Time,
        field: ModernTreasury::Models::RequestedAction::field?,
        instructions: String?,
        live_mode: bool,
        object: String,
        reasons: ::Array[String],
        updated_at: Time
      }

      type category =
        :onboarding_articles_of_incorporation_failure
        | :onboarding_business_registry_verification_failure
        | :onboarding_database_failure
        | :onboarding_proof_of_address_failure
        | :onboarding_ssn_check_failure
        | :onboarding_tin_check_failure

      module Category
        extend ModernTreasury::Internal::Type::Enum

        ONBOARDING_ARTICLES_OF_INCORPORATION_FAILURE: :onboarding_articles_of_incorporation_failure
        ONBOARDING_BUSINESS_REGISTRY_VERIFICATION_FAILURE: :onboarding_business_registry_verification_failure
        ONBOARDING_DATABASE_FAILURE: :onboarding_database_failure
        ONBOARDING_PROOF_OF_ADDRESS_FAILURE: :onboarding_proof_of_address_failure
        ONBOARDING_SSN_CHECK_FAILURE: :onboarding_ssn_check_failure
        ONBOARDING_TIN_CHECK_FAILURE: :onboarding_tin_check_failure

        def self?.values: -> ::Array[ModernTreasury::Models::RequestedAction::category]
      end

      type field =
        :articles_of_incorporation
        | :ein_letter
        | :legal_entity_details
        | :proof_of_address

      module Field
        extend ModernTreasury::Internal::Type::Enum

        ARTICLES_OF_INCORPORATION: :articles_of_incorporation
        EIN_LETTER: :ein_letter
        LEGAL_ENTITY_DETAILS: :legal_entity_details
        PROOF_OF_ADDRESS: :proof_of_address

        def self?.values: -> ::Array[ModernTreasury::Models::RequestedAction::field]
      end
    end
  end
end
