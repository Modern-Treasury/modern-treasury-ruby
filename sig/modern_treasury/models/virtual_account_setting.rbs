module ModernTreasury
  module Models
    type virtual_account_setting =
      {
        id: String,
        created_at: Time,
        external_id: String?,
        live_mode: bool,
        object: String,
        updated_at: Time
      }

    class VirtualAccountSetting < ModernTreasury::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created_at: Time

      attr_accessor external_id: String?

      attr_accessor live_mode: bool

      attr_accessor object: String

      attr_accessor updated_at: Time

      def initialize: (
        id: String,
        created_at: Time,
        external_id: String?,
        live_mode: bool,
        object: String,
        updated_at: Time
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        external_id: String?,
        live_mode: bool,
        object: String,
        updated_at: Time
      }
    end
  end
end
