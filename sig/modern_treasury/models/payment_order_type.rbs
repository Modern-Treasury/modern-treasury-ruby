module ModernTreasury
  module Models
    type payment_order_type =
      :ach
      | :au_becs
      | :bacs
      | :book
      | :card
      | :chats
      | :check
      | :cross_border
      | :dk_nets
      | :eft
      | :gb_fps
      | :masav
      | :mx_ccen
      | :neft
      | :nics
      | :nz_becs
      | :pl_elixir
      | :rtp
      | :se_bankgirot
      | :sepa
      | :sg_giro
      | :sic
      | :stablecoin
      | :wire
      | :zengin

    module PaymentOrderType
      extend ModernTreasury::Internal::Type::Enum

      ACH: :ach
      AU_BECS: :au_becs
      BACS: :bacs
      BOOK: :book
      CARD: :card
      CHATS: :chats
      CHECK: :check
      CROSS_BORDER: :cross_border
      DK_NETS: :dk_nets
      EFT: :eft
      GB_FPS: :gb_fps
      MASAV: :masav
      MX_CCEN: :mx_ccen
      NEFT: :neft
      NICS: :nics
      NZ_BECS: :nz_becs
      PL_ELIXIR: :pl_elixir
      RTP: :rtp
      SE_BANKGIROT: :se_bankgirot
      SEPA: :sepa
      SG_GIRO: :sg_giro
      SIC: :sic
      STABLECOIN: :stablecoin
      WIRE: :wire
      ZENGIN: :zengin

      def self?.values: -> ::Array[ModernTreasury::Models::payment_order_type]
    end
  end
end
