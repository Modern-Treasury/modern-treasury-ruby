      attr_reader template: ModernTreasury::Models::EmbeddableFlowListParams::template?

      def template=: (
        ModernTreasury::Models::EmbeddableFlowListParams::template
      ) -> ModernTreasury::Models::EmbeddableFlowListParams::template

