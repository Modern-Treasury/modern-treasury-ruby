module ModernTreasury
  module Models
    type account_detail_create_request =
      {
        account_number: String,
        account_number_type: ModernTreasury::Models::AccountDetailCreateRequest::account_number_type
      }

    class AccountDetailCreateRequest < ModernTreasury::Internal::Type::BaseModel
      attr_accessor account_number: String

      attr_reader account_number_type: ModernTreasury::Models::AccountDetailCreateRequest::account_number_type?

      def account_number_type=: (
        ModernTreasury::Models::AccountDetailCreateRequest::account_number_type
      ) -> ModernTreasury::Models::AccountDetailCreateRequest::account_number_type

      def initialize: (
        account_number: String,
        ?account_number_type: ModernTreasury::Models::AccountDetailCreateRequest::account_number_type
      ) -> void

      def to_hash: -> {
        account_number: String,
        account_number_type: ModernTreasury::Models::AccountDetailCreateRequest::account_number_type
      }

      type account_number_type =
        :arbitrum_address
        | :au_number
        | :avalanche_address
        | :base_address
        | :card_token
        | :clabe
        | :ethereum_address
        | :hk_number
        | :iban
        | :id_number
        | :nz_number
        | :other
        | :pan
        | :polygon_address
        | :sg_number
        | :solana_address

      module AccountNumberType
        extend ModernTreasury::Internal::Type::Enum

        ARBITRUM_ADDRESS: :arbitrum_address
        AU_NUMBER: :au_number
        AVALANCHE_ADDRESS: :avalanche_address
        BASE_ADDRESS: :base_address
        CARD_TOKEN: :card_token
        CLABE: :clabe
        ETHEREUM_ADDRESS: :ethereum_address
        HK_NUMBER: :hk_number
        IBAN: :iban
        ID_NUMBER: :id_number
        NZ_NUMBER: :nz_number
        OTHER: :other
        PAN: :pan
        POLYGON_ADDRESS: :polygon_address
        SG_NUMBER: :sg_number
        SOLANA_ADDRESS: :solana_address

        def self?.values: -> ::Array[ModernTreasury::Models::AccountDetailCreateRequest::account_number_type]
      end
    end
  end
end
