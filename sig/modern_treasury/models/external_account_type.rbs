module ModernTreasury
  module Models
    type external_account_type =
      :cash
      | :checking
      | :general_ledger
      | :hosted_wallet
      | :loan
      | :non_resident
      | :other
      | :overdraft
      | :savings
      | :self_hosted_wallet

    module ExternalAccountType
      extend ModernTreasury::Internal::Type::Enum

      CASH: :cash
      CHECKING: :checking
      GENERAL_LEDGER: :general_ledger
      HOSTED_WALLET: :hosted_wallet
      LOAN: :loan
      NON_RESIDENT: :non_resident
      OTHER: :other
      OVERDRAFT: :overdraft
      SAVINGS: :savings
      SELF_HOSTED_WALLET: :self_hosted_wallet

      def self?.values: -> ::Array[ModernTreasury::Models::external_account_type]
    end
  end
end
