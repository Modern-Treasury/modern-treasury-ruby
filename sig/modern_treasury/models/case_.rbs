module ModernTreasury
  module Models
    type case_ =
      {
        id: String,
        created_at: Time,
        live_mode: bool,
        object: String,
        requested_actions: ::Array[ModernTreasury::RequestedAction],
        resolved_actions: ::Array[ModernTreasury::RequestedAction],
        status: ModernTreasury::Models::Case::status,
        subject_id: String,
        subject_type: String,
        updated_at: Time
      }

    class Case < ModernTreasury::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created_at: Time

      attr_accessor live_mode: bool

      attr_accessor object: String

      attr_accessor requested_actions: ::Array[ModernTreasury::RequestedAction]

      attr_accessor resolved_actions: ::Array[ModernTreasury::RequestedAction]

      attr_accessor status: ModernTreasury::Models::Case::status

      attr_accessor subject_id: String

      attr_accessor subject_type: String

      attr_accessor updated_at: Time

      def initialize: (
        id: String,
        created_at: Time,
        live_mode: bool,
        object: String,
        requested_actions: ::Array[ModernTreasury::RequestedAction],
        resolved_actions: ::Array[ModernTreasury::RequestedAction],
        status: ModernTreasury::Models::Case::status,
        subject_id: String,
        subject_type: String,
        updated_at: Time
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        live_mode: bool,
        object: String,
        requested_actions: ::Array[ModernTreasury::RequestedAction],
        resolved_actions: ::Array[ModernTreasury::RequestedAction],
        status: ModernTreasury::Models::Case::status,
        subject_id: String,
        subject_type: String,
        updated_at: Time
      }

      type status = :open | :resolved

      module Status
        extend ModernTreasury::Internal::Type::Enum

        OPEN: :open
        RESOLVED: :resolved

        def self?.values: -> ::Array[ModernTreasury::Models::Case::status]
      end
    end
  end
end
