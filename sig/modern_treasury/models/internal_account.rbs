module ModernTreasury
  module Models
    type internal_account =
      {
        id: String,
        account_capabilities: ::Array[ModernTreasury::InternalAccount::AccountCapability],
        account_details: ::Array[ModernTreasury::AccountDetail],
        account_type: ModernTreasury::Models::InternalAccount::account_type?,
        allowed_ach_debit_company_ids: ::Array[String]?,
        connection: ModernTreasury::Connection,
        contra_ledger_account_id: String?,
        counterparty_id: String?,
        created_at: Time,
        currency: ModernTreasury::Models::currency,
        debitable: bool?,
        external_id: String?,
        ledger_account_id: String?,
        legal_entity_id: String?,
        live_mode: bool,
        metadata: ::Hash[Symbol, String],
        name: String?,
        object: String,
        parent_account_id: String?,
        party_address: ModernTreasury::Address?,
        party_name: String,
        party_type: ModernTreasury::Models::InternalAccount::party_type?,
        routing_details: ::Array[ModernTreasury::RoutingDetail],
        status: ModernTreasury::Models::InternalAccount::status?,
        title: String,
        updated_at: Time,
        vendor_id: String?,
        latest_balances: ::Array[ModernTreasury::InternalAccount::LatestBalance]
      }

    class InternalAccount < ModernTreasury::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor account_capabilities: ::Array[ModernTreasury::InternalAccount::AccountCapability]

      attr_accessor account_details: ::Array[ModernTreasury::AccountDetail]

      attr_accessor account_type: ModernTreasury::Models::InternalAccount::account_type?

      attr_accessor allowed_ach_debit_company_ids: ::Array[String]?

      attr_accessor connection: ModernTreasury::Connection

      attr_accessor contra_ledger_account_id: String?

      attr_accessor counterparty_id: String?

      attr_accessor created_at: Time

      attr_accessor currency: ModernTreasury::Models::currency

      attr_accessor debitable: bool?

      attr_accessor external_id: String?

      attr_accessor ledger_account_id: String?

      attr_accessor legal_entity_id: String?

      attr_accessor live_mode: bool

      attr_accessor metadata: ::Hash[Symbol, String]

      attr_accessor name: String?

      attr_accessor object: String

      attr_accessor parent_account_id: String?

      attr_accessor party_address: ModernTreasury::Address?

      attr_accessor party_name: String

      attr_accessor party_type: ModernTreasury::Models::InternalAccount::party_type?

      attr_accessor routing_details: ::Array[ModernTreasury::RoutingDetail]

      attr_accessor status: ModernTreasury::Models::InternalAccount::status?

      attr_accessor title: String

      attr_accessor updated_at: Time

      attr_accessor vendor_id: String?

      attr_reader latest_balances: ::Array[ModernTreasury::InternalAccount::LatestBalance]?

      def latest_balances=: (
        ::Array[ModernTreasury::InternalAccount::LatestBalance]
      ) -> ::Array[ModernTreasury::InternalAccount::LatestBalance]

      def initialize: (
        id: String,
        account_capabilities: ::Array[ModernTreasury::InternalAccount::AccountCapability],
        account_details: ::Array[ModernTreasury::AccountDetail],
        account_type: ModernTreasury::Models::InternalAccount::account_type?,
        allowed_ach_debit_company_ids: ::Array[String]?,
        connection: ModernTreasury::Connection,
        contra_ledger_account_id: String?,
        counterparty_id: String?,
        created_at: Time,
        currency: ModernTreasury::Models::currency,
        debitable: bool?,
        external_id: String?,
        ledger_account_id: String?,
        legal_entity_id: String?,
        live_mode: bool,
        metadata: ::Hash[Symbol, String],
        name: String?,
        object: String,
        parent_account_id: String?,
        party_address: ModernTreasury::Address?,
        party_name: String,
        party_type: ModernTreasury::Models::InternalAccount::party_type?,
        routing_details: ::Array[ModernTreasury::RoutingDetail],
        status: ModernTreasury::Models::InternalAccount::status?,
        title: String,
        updated_at: Time,
        vendor_id: String?,
        ?latest_balances: ::Array[ModernTreasury::InternalAccount::LatestBalance]
      ) -> void

      def to_hash: -> {
        id: String,
        account_capabilities: ::Array[ModernTreasury::InternalAccount::AccountCapability],
        account_details: ::Array[ModernTreasury::AccountDetail],
        account_type: ModernTreasury::Models::InternalAccount::account_type?,
        allowed_ach_debit_company_ids: ::Array[String]?,
        connection: ModernTreasury::Connection,
        contra_ledger_account_id: String?,
        counterparty_id: String?,
        created_at: Time,
        currency: ModernTreasury::Models::currency,
        debitable: bool?,
        external_id: String?,
        ledger_account_id: String?,
        legal_entity_id: String?,
        live_mode: bool,
        metadata: ::Hash[Symbol, String],
        name: String?,
        object: String,
        parent_account_id: String?,
        party_address: ModernTreasury::Address?,
        party_name: String,
        party_type: ModernTreasury::Models::InternalAccount::party_type?,
        routing_details: ::Array[ModernTreasury::RoutingDetail],
        status: ModernTreasury::Models::InternalAccount::status?,
        title: String,
        updated_at: Time,
        vendor_id: String?,
        latest_balances: ::Array[ModernTreasury::InternalAccount::LatestBalance]
      }

      type account_capability =
        {
          id: String,
          created_at: Time,
          direction: ModernTreasury::Models::transaction_direction,
          discarded_at: Time?,
          identifier: String?,
          live_mode: bool,
          object: String,
          payment_type: ModernTreasury::Models::InternalAccount::AccountCapability::payment_type,
          updated_at: Time
        }

      class AccountCapability < ModernTreasury::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor created_at: Time

        attr_accessor direction: ModernTreasury::Models::transaction_direction

        attr_accessor discarded_at: Time?

        attr_accessor identifier: String?

        attr_accessor live_mode: bool

        attr_accessor object: String

        attr_accessor payment_type: ModernTreasury::Models::InternalAccount::AccountCapability::payment_type

        attr_accessor updated_at: Time

        def initialize: (
          id: String,
          created_at: Time,
          direction: ModernTreasury::Models::transaction_direction,
          discarded_at: Time?,
          identifier: String?,
          live_mode: bool,
          object: String,
          payment_type: ModernTreasury::Models::InternalAccount::AccountCapability::payment_type,
          updated_at: Time
        ) -> void

        def to_hash: -> {
          id: String,
          created_at: Time,
          direction: ModernTreasury::Models::transaction_direction,
          discarded_at: Time?,
          identifier: String?,
          live_mode: bool,
          object: String,
          payment_type: ModernTreasury::Models::InternalAccount::AccountCapability::payment_type,
          updated_at: Time
        }

        type payment_type =
          :ach
          | :au_becs
          | :bacs
          | :book
          | :card
          | :chats
          | :check
          | :cross_border
          | :dk_nets
          | :eft
          | :gb_fps
          | :masav
          | :mx_ccen
          | :neft
          | :nics
          | :nz_becs
          | :pl_elixir
          | :rtp
          | :se_bankgirot
          | :sepa
          | :sg_giro
          | :sic
          | :stablecoin
          | :wire
          | :zengin

        module PaymentType
          extend ModernTreasury::Internal::Type::Enum

          ACH: :ach
          AU_BECS: :au_becs
          BACS: :bacs
          BOOK: :book
          CARD: :card
          CHATS: :chats
          CHECK: :check
          CROSS_BORDER: :cross_border
          DK_NETS: :dk_nets
          EFT: :eft
          GB_FPS: :gb_fps
          MASAV: :masav
          MX_CCEN: :mx_ccen
          NEFT: :neft
          NICS: :nics
          NZ_BECS: :nz_becs
          PL_ELIXIR: :pl_elixir
          RTP: :rtp
          SE_BANKGIROT: :se_bankgirot
          SEPA: :sepa
          SG_GIRO: :sg_giro
          SIC: :sic
          STABLECOIN: :stablecoin
          WIRE: :wire
          ZENGIN: :zengin

          def self?.values: -> ::Array[ModernTreasury::Models::InternalAccount::AccountCapability::payment_type]
        end
      end

      type account_type =
        :cash
        | :checking
        | :general_ledger
        | :hosted_wallet
        | :loan
        | :non_resident
        | :other
        | :overdraft
        | :savings
        | :self_hosted_wallet

      module AccountType
        extend ModernTreasury::Internal::Type::Enum

        CASH: :cash
        CHECKING: :checking
        GENERAL_LEDGER: :general_ledger
        HOSTED_WALLET: :hosted_wallet
        LOAN: :loan
        NON_RESIDENT: :non_resident
        OTHER: :other
        OVERDRAFT: :overdraft
        SAVINGS: :savings
        SELF_HOSTED_WALLET: :self_hosted_wallet

        def self?.values: -> ::Array[ModernTreasury::Models::InternalAccount::account_type]
      end

      type party_type = :business | :individual

      module PartyType
        extend ModernTreasury::Internal::Type::Enum

        BUSINESS: :business
        INDIVIDUAL: :individual

        def self?.values: -> ::Array[ModernTreasury::Models::InternalAccount::party_type]
      end

      type status =
        :active | :closed | :pending_activation | :pending_closure | :suspended

      module Status
        extend ModernTreasury::Internal::Type::Enum

        ACTIVE: :active
        CLOSED: :closed
        PENDING_ACTIVATION: :pending_activation
        PENDING_CLOSURE: :pending_closure
        SUSPENDED: :suspended

        def self?.values: -> ::Array[ModernTreasury::Models::InternalAccount::status]
      end

      type latest_balance =
        {
          id: String,
          amount: Integer,
          amount_string: String,
          as_of_date: Date?,
          as_of_time: Time?,
          balance_type: ModernTreasury::Models::InternalAccount::LatestBalance::balance_type,
          created_at: Time,
          currency: ModernTreasury::Models::currency,
          live_mode: bool,
          object: String,
          updated_at: Time,
          value_date: Date?,
          vendor_code: String,
          vendor_code_type: String?
        }

      class LatestBalance < ModernTreasury::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor amount: Integer

        attr_accessor amount_string: String

        attr_accessor as_of_date: Date?

        attr_accessor as_of_time: Time?

        attr_accessor balance_type: ModernTreasury::Models::InternalAccount::LatestBalance::balance_type

        attr_accessor created_at: Time

        attr_accessor currency: ModernTreasury::Models::currency

        attr_accessor live_mode: bool

        attr_accessor object: String

        attr_accessor updated_at: Time

        attr_accessor value_date: Date?

        attr_accessor vendor_code: String

        attr_accessor vendor_code_type: String?

        def initialize: (
          id: String,
          amount: Integer,
          amount_string: String,
          as_of_date: Date?,
          as_of_time: Time?,
          balance_type: ModernTreasury::Models::InternalAccount::LatestBalance::balance_type,
          created_at: Time,
          currency: ModernTreasury::Models::currency,
          live_mode: bool,
          object: String,
          updated_at: Time,
          value_date: Date?,
          vendor_code: String,
          vendor_code_type: String?
        ) -> void

        def to_hash: -> {
          id: String,
          amount: Integer,
          amount_string: String,
          as_of_date: Date?,
          as_of_time: Time?,
          balance_type: ModernTreasury::Models::InternalAccount::LatestBalance::balance_type,
          created_at: Time,
          currency: ModernTreasury::Models::currency,
          live_mode: bool,
          object: String,
          updated_at: Time,
          value_date: Date?,
          vendor_code: String,
          vendor_code_type: String?
        }

        type balance_type =
          :closing_available
          | :closing_ledger
          | :closing_pending_inflows
          | :closing_pending_outflows
          | :current_available
          | :current_ledger
          | :current_pending_inflows
          | :current_pending_outflows
          | :opening_available
          | :opening_available_next_business_day
          | :opening_ledger
          | :other
          | :previously_closed_book

        module BalanceType
          extend ModernTreasury::Internal::Type::Enum

          CLOSING_AVAILABLE: :closing_available
          CLOSING_LEDGER: :closing_ledger
          CLOSING_PENDING_INFLOWS: :closing_pending_inflows
          CLOSING_PENDING_OUTFLOWS: :closing_pending_outflows
          CURRENT_AVAILABLE: :current_available
          CURRENT_LEDGER: :current_ledger
          CURRENT_PENDING_INFLOWS: :current_pending_inflows
          CURRENT_PENDING_OUTFLOWS: :current_pending_outflows
          OPENING_AVAILABLE: :opening_available
          OPENING_AVAILABLE_NEXT_BUSINESS_DAY: :opening_available_next_business_day
          OPENING_LEDGER: :opening_ledger
          OTHER: :other
          PREVIOUSLY_CLOSED_BOOK: :previously_closed_book

          def self?.values: -> ::Array[ModernTreasury::Models::InternalAccount::LatestBalance::balance_type]
        end
      end
    end
  end
end
