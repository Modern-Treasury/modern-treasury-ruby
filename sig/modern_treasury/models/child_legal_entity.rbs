        third_party_verifications: ::Array[ModernTreasury::ThirdPartyVerification],
        ticker_symbol: String?,
        updated_at: Time,
        wealth_and_employment_details: ModernTreasury::LegalEntityWealthEmploymentDetail?,
        website: String?
      ) -> void

      def to_hash: -> {
        id: String,
        addresses: ::Array[ModernTreasury::ChildLegalEntity::Address],
        bank_settings: ModernTreasury::LegalEntityBankSettings?,
        business_description: String?,
        business_designation: ModernTreasury::Models::ChildLegalEntity::business_designation?,
        business_name: String?,
