        documents: ::Array[ModernTreasury::Document],
        doing_business_as_names: ::Array[String],
        email: String?,
        expected_activity_volume: Integer?,
        external_id: String?,
        first_name: String?,
        identifications: ::Array[ModernTreasury::Identification],
        industry_classifications: ::Array[ModernTreasury::LegalEntityIndustryClassification],
        intended_use: String?,
